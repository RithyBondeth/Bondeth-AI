NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin, with no path. Used for canonical URLs, sitemap, structured data and social images.
# Set to your real HTTPS domain before the production build (localhost is never indexable).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Build-time switch: set false for staging/preview deployments, even with a public domain.
SEO_INDEXING=true
