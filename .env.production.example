# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in
# every value marked REQUIRED; the backend refuses to start until they are real.
# Full walkthrough: docs/deploy.md

BONDETH_ENV=production

# REQUIRED: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BONDETH_JWT_SECRET=

# REQUIRED: a long random password (same generator). Set it before the first start;
# PostgreSQL only reads it when the data volume is created.
POSTGRES_USER=bondeth
POSTGRES_PASSWORD=
POSTGRES_DB=bondeth

# REQUIRED: your domain, with DNS A/AAAA records pointing at this server.
APP_DOMAIN=bondeth.example.org
# REQUIRED: Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=
# The API is served from the same origin under /api/v1 (see deploy/caddy/Caddyfile).
PUBLIC_APP_URL=https://bondeth.example.org
PUBLIC_API_URL=https://bondeth.example.org
SEO_INDEXING=true
# Shown on /privacy and /terms for privacy and support requests.
CONTACT_EMAIL=

# REQUIRED: an SMTP relay (Resend, Amazon SES, Postmark...). Add the provider's SPF and
# DKIM DNS records for the sender domain, or verification emails land in spam.
BONDETH_EMAIL_BACKEND=smtp
BONDETH_EMAIL_FROM=Bondeth AI <no-reply@bondeth.example.org>
BONDETH_SMTP_HOST=
BONDETH_SMTP_PORT=587
BONDETH_SMTP_USERNAME=
BONDETH_SMTP_PASSWORD=

# Models: ~6 GB downloaded on first start, then reused.
MODELS_PATH=./backend/models
BONDETH_PRELOAD_MODELS=true
# CPU-only servers: false (phrases appear after each pause instead of while speaking).
BONDETH_STT_LIVE_PARTIALS=true

# mms/omnivoice weights are non-commercial (CC BY-NC). Free service only; switch both to
# voxcpm (GPU image) before charging money or showing ads.
BONDETH_TTS_ENGINE=mms
BONDETH_CLONE_ENGINE=omnivoice

BONDETH_LIMITS_ENABLED=true
BONDETH_SOURCE_AUDIO_STORAGE_MB=1024
BONDETH_SOURCE_AUDIO_MAX_MB=128

# Recommended: error tracking (sentry.io or self-hosted). Bodies, local variables and
# user details are never sent; see backend/app/monitoring.py.
BONDETH_SENTRY_DSN=

# Paid plans stay off until both engines are voxcpm (the backend enforces this).
BONDETH_BILLING_ENABLED=false
BONDETH_STRIPE_SECRET_KEY=
BONDETH_STRIPE_WEBHOOK_SECRET=
BONDETH_STRIPE_PRO_PRICE_ID=
