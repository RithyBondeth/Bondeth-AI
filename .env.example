# Copy to .env (next to docker-compose.yml) before `docker compose --profile app up`.

# Required: signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BONDETH_JWT_SECRET=

# Database credentials (change them for anything public).
POSTGRES_USER=bondeth
POSTGRES_PASSWORD=bondeth
POSTGRES_DB=bondeth

# Where users reach the app and the API, as seen from their browser.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Model cache on the host (~6 GB). Reuses backend/models from local development by default.
MODELS_PATH=./backend/models
# Load models at startup (slow first boot, fast first request). false = load on first use.
BONDETH_PRELOAD_MODELS=true

# Speech engines. mms (TTS) and omnivoice (cloning) weights are non-commercial (CC BY-NC).
# voxcpm = VoxCPM2 (Apache-2.0, commercial use OK); included in the GPU image, ~8 GB VRAM.
BONDETH_TTS_ENGINE=mms
BONDETH_CLONE_ENGINE=omnivoice

# Usage limits: per-minute rate limits and daily allowances per user (or per IP when signed out).
# Defaults and the individual BONDETH_RATE_LIMIT_* / BONDETH_QUOTA_* knobs are in backend/app/config.py.
# false = keep counting usage but never block (e.g. a private single-user install).
BONDETH_LIMITS_ENABLED=true
# Limits are per client IP for signed-out users. If a reverse proxy (nginx, Caddy, a load balancer)
# sits in front of the backend, list its IP(s) here so the real client IP is used. Never use "*" while
# the backend port is reachable directly: clients could then fake their IP.
FORWARDED_ALLOW_IPS=127.0.0.1
