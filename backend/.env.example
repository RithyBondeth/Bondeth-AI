# Copy to .env and adjust
BONDETH_ENV=development
BONDETH_CORS_ORIGINS=["http://localhost:3000"]
BONDETH_MODEL_DIR=./models
BONDETH_TMP_DIR=./tmp

# Speech-to-text
BONDETH_STT_MODEL=large-v3-turbo
BONDETH_STT_DEVICE=cpu
BONDETH_STT_COMPUTE_TYPE=int8
BONDETH_STT_PRELOAD=false
BONDETH_STT_EN_THRESHOLD=0.6
BONDETH_STT_KM_MODEL=kavatana/whisper-turbo-khmer-v9-ct2-int8
BONDETH_MAX_UPLOAD_MB=25
# Transcription jobs (POST /stt/jobs): long uploads, segments streamed over SSE
BONDETH_STT_JOB_MAX_UPLOAD_MB=200
BONDETH_STT_JOB_MAX_QUEUE=20
BONDETH_STT_WORKER_ENABLED=true
# Private source recordings: per-account and per-recording decoded WAV limits (MiB).
BONDETH_SOURCE_AUDIO_STORAGE_MB=1024
BONDETH_SOURCE_AUDIO_MAX_MB=128
# Live dictation: set false on CPU-only servers (previews cost a full Whisper pass each)
BONDETH_STT_LIVE_PARTIALS=true

# Text-to-speech. mms weights are non-commercial; voxcpm (Apache-2.0) needs requirements-voxcpm.txt
# mms = fast; omnivoice = quality-first (installed with standard dependencies;
# slower on a laptop, non-commercial weights). voxcpm needs its optional requirements.
BONDETH_TTS_ENGINE=mms
# OmniVoice uses attribute tags, not free-form prose. Reference is synthetic, never a user's voice.
BONDETH_TTS_OMNI_VOICE=female, young adult, moderate pitch
BONDETH_TTS_OMNI_KHMER_CHARS_PER_SECOND=12.0
BONDETH_TTS_MAX_CHARS=2000
BONDETH_TTS_PRELOAD=false
BONDETH_TTS_CACHE_ENABLED=true
BONDETH_TTS_CACHE_TTL_S=604800
BONDETH_TTS_CACHE_MAX_BYTES=2000000

# Voice cloning: omnivoice (non-commercial weights) or voxcpm (Apache-2.0)
BONDETH_CLONE_ENGINE=omnivoice
BONDETH_CLONE_DEVICE=auto
# More generation steps favor fidelity over latency (16-64; OmniVoice only).
BONDETH_CLONE_OMNI_STEPS=48
# Private, process-local exact-result reuse; never reduces steps or precision.
BONDETH_CLONE_CACHE_ENABLED=true
BONDETH_CLONE_CACHE_TTL_S=300
BONDETH_CLONE_CACHE_MAX_ENTRIES=16
BONDETH_CLONE_CACHE_MAX_BYTES=16777216
# Prefer 5-10 seconds of one clear speaker and the exact spoken transcript.
BONDETH_CLONE_MAX_CHARS=500
BONDETH_CLONE_PRELOAD=false

# VoxCPM2, when selected above (~8 GB VRAM on CUDA; mps/cpu work but slowly)
BONDETH_VOXCPM_DEVICE=auto
BONDETH_VOXCPM_INFERENCE_TIMESTEPS=10
# BONDETH_VOXCPM_HOUSE_VOICE=A warm, clear adult female voice, friendly and calm, studio quality

# Usage limits (see limits.py). Per caller: the signed-in user, otherwise the client IP.
BONDETH_LIMITS_ENABLED=true
BONDETH_RATE_LIMIT_WINDOW_S=60
BONDETH_RATE_LIMIT_ANON=10
BONDETH_RATE_LIMIT_USER=30
BONDETH_RATE_LIMIT_API_KEY=60
BONDETH_RATE_LIMIT_CHEAP=120
BONDETH_QUOTA_UTC_OFFSET_HOURS=7
BONDETH_QUOTA_STT_SECONDS_ANON=600
BONDETH_QUOTA_STT_SECONDS_USER=3600
BONDETH_QUOTA_TTS_CHARS_ANON=5000
BONDETH_QUOTA_TTS_CHARS_USER=50000
BONDETH_QUOTA_CLONE_JOBS_USER=20
BONDETH_MAX_API_KEYS_PER_USER=10

# Infrastructure (docker compose up -d)
BONDETH_DATABASE_URL=postgresql+asyncpg://bondeth:bondeth@localhost:5432/bondeth
BONDETH_REDIS_URL=redis://localhost:6379/0
BONDETH_DATA_DIR=./data

# Email (verification and password-reset links point at BONDETH_PUBLIC_APP_URL)
BONDETH_PUBLIC_APP_URL=http://localhost:3000
BONDETH_EMAIL_BACKEND=log
# BONDETH_EMAIL_BACKEND=smtp
# BONDETH_EMAIL_FROM=Bondeth AI <no-reply@example.com>
# BONDETH_SMTP_HOST=smtp.example.com
# BONDETH_SMTP_PORT=587
# BONDETH_SMTP_USERNAME=
# BONDETH_SMTP_PASSWORD=
BONDETH_REGISTER_MAX_PER_IP=5

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Required (the app refuses to start without it) when BONDETH_ENV is not development/test.
# BONDETH_JWT_SECRET=<long random value>

# Optional Pro subscriptions (both speech engines must be voxcpm when enabled).
BONDETH_BILLING_ENABLED=false
BONDETH_STRIPE_SECRET_KEY=
BONDETH_STRIPE_WEBHOOK_SECRET=
BONDETH_STRIPE_PRO_PRICE_ID=
BONDETH_QUOTA_STT_SECONDS_PRO=18000
BONDETH_QUOTA_TTS_CHARS_PRO=250000
BONDETH_QUOTA_CLONE_JOBS_PRO=100
