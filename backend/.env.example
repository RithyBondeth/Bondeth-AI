# Copy to .env and adjust
BONDETH_ENV=development
BONDETH_CORS_ORIGINS=["http://localhost:3000"]
BONDETH_MODEL_DIR=./models
BONDETH_TMP_DIR=./tmp

# Speech-to-text
BONDETH_STT_MODEL=large-v3-turbo
BONDETH_STT_DEVICE=cpu
BONDETH_STT_COMPUTE_TYPE=int8
BONDETH_STT_PRELOAD=false
BONDETH_STT_EN_THRESHOLD=0.6
BONDETH_STT_KM_MODEL=kavatana/whisper-turbo-khmer-v9-ct2-int8
BONDETH_MAX_UPLOAD_MB=25

# Text-to-speech
BONDETH_TTS_MAX_CHARS=2000
BONDETH_TTS_PRELOAD=false

# Voice cloning (OmniVoice; weights are non-commercial)
BONDETH_CLONE_DEVICE=auto
BONDETH_CLONE_MAX_CHARS=500
BONDETH_CLONE_PRELOAD=false

# Infrastructure (docker compose up -d)
BONDETH_DATABASE_URL=postgresql+asyncpg://bondeth:bondeth@localhost:5432/bondeth
BONDETH_REDIS_URL=redis://localhost:6379/0
BONDETH_DATA_DIR=./data

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Required (the app refuses to start without it) when BONDETH_ENV is not development/test.
# BONDETH_JWT_SECRET=<long random value>
